PORT=4100
CLIENT_ORIGIN=http://localhost:3000

# Cloudinary (Optional, for receipt and asset storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Database
# Find these in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Aethex Voice AI
# Developer Portal: https://developers.aethexai.com
AETHEX_API_KEY=
AETHEX_API_BASE_URL=https://api.aethexai.com/api/v1
# Agent ID configured in Aethex for booking calls
AETHEX_AGENT_ID=
# Outbound registered phone number in E.164 format (+1...)
AETHEX_FROM_NUMBER=

# Resend Email API
# Dashboard: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Reserv <onboarding@resend.dev>

# Authentication
JWT_SECRET=
# Set to your actual reverse proxy hop count when deployed
TRUST_PROXY_HOPS=

# Automated Voice Reminders & Cron
ENABLE_CALL_SCHEDULER=true
CALL_REMINDER_CRON="*/5 * * * *"
# Optional secret to protect POST /api/calls/cron/reminders from unauthorized triggers
CRON_SECRET=


# Configure this same secret as x-webhook-secret at your webhook sender.
AETHEX_WEBHOOK_SECRET=
