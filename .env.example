PORT=4100
# Comma-separated allowed origins (e.g. http://localhost:3000,http://localhost:3003,https://your-domain.railway.app)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3003

# Cloudinary (Optional, for business image assets; receipts use private Supabase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Database
# Find these in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Aethex Voice AI
# Developer Portal: https://developers.aethexai.com
AETHEX_API_KEY=
AETHEX_API_BASE_URL=https://api.aethexai.com/api/v1
# Agent ID configured in Aethex for booking calls
AETHEX_AGENT_ID=
# Outbound registered phone number in E.164 format, including country code
AETHEX_FROM_NUMBER=

# Resend Email API
# Dashboard: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Reserv <onboarding@resend.dev>

# Authentication
JWT_SECRET=
# Set to your actual reverse proxy hop count when deployed
TRUST_PROXY_HOPS=

# Automated Voice Reminders & Cron
ENABLE_CALL_SCHEDULER=false
CALL_REMINDER_CRON="*/5 * * * *"
# Required secret to enable POST /api/calls/cron/reminders from unauthorized triggers
CRON_SECRET=


# Aethex tenant signing secret for X-Aethex-Signature verification.
AETHEX_WEBHOOK_SECRET=

# Booking checkout (NGN). Hosted checkout needs no frontend/public payment keys.
# Exact frontend origin, no path/query; HTTPS is required in production.
PAYMENT_RETURN_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=
# Both Stripe values are required before its payment option enables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checks unresolved payments every five minutes when a provider is configured.
ENABLE_PAYMENT_RECONCILIATION=true

# Administrative Aethex setup for an existing Twilio number (never frontend variables).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Aethex UUID returned when a Twilio account is connected; not the Twilio Account SID.
AETHEX_TWILIO_ACCOUNT_ID=
